{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/search",
      "destination": "/search.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/cart/add.js",
      "destination": "/cart.json"
    },
    {
      "source": "/cart/change.js",
      "destination": "/cart.json"
    },
    {
      "source": "/cart/clear.js",
      "destination": "/cart.json"
    },
    {
      "source": "/cart/update.js",
      "destination": "/cart.json"
    },
    {
      "source": "/cart.js",
      "destination": "/cart.json"
    },
    {
      "source": "/collections/:category/products/:slug",
      "destination": "/products/:slug.html"
    },
    {
      "source": "/collections/:category",
      "destination": "/collections/:category.html"
    },
    {
      "source": "/products/:slug",
      "destination": "/products/:slug.html"
    },
    {
      "source": "/pages/:page",
      "destination": "/pages/:page.html"
    }
  ]
}
